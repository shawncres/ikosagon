{
  "id": "customer_service",
  "title": "Customer Service",
  "vertical": "customer_service",
  "description": "Conversational greet → verify (name or account / new customer) → diagnose → policy RAG → resolve, callback, or escalate.",
  "start": "greet",
  "ragCorpus": "cs",
  "tools": [
    "lookupAccount",
    "createCustomer",
    "createCase",
    "scheduleCallback",
    "logDisposition"
  ],
  "nodes": {
    "greet": {
      "id": "greet",
      "label": "Greet",
      "agentSay": [
        "Hello there — how can I help you today?"
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "greeting",
          "examples": [
            "hi",
            "hello",
            "hey",
            "good morning",
            "thanks",
            "hi there"
          ]
        },
        {
          "intent": "describe_issue",
          "examples": [
            "my order is late",
            "I need a refund",
            "login problem",
            "billing issue",
            "wrong item arrived",
            "product is defective",
            "charged twice",
            "package never came",
            "I want to exchange this",
            "password reset"
          ]
        },
        {
          "intent": "ask_policy",
          "examples": [
            "what's your return policy",
            "warranty question",
            "how long is shipping",
            "restocking fee?"
          ]
        },
        {
          "intent": "provide_account",
          "examples": [
            "my account is 1001",
            "account 2044"
          ]
        },
        {
          "intent": "provide_name",
          "examples": [
            "my name is Maya Chen",
            "I'm Chris Patel"
          ]
        },
        {
          "intent": "no_account",
          "examples": [
            "I don't have an account",
            "I'm a new customer"
          ]
        }
      ],
      "transitions": [
        {
          "on": "describe_issue",
          "to": "verify"
        },
        {
          "on": "ask_policy",
          "to": "verify"
        },
        {
          "on": "provide_account",
          "to": "verify"
        },
        {
          "on": "provide_name",
          "to": "verify"
        },
        {
          "on": "no_account",
          "to": "verify"
        }
      ],
      "agentSayVariants": {
        "greetingReply": [
          "Hi! What can I help you with today?",
          "Hey there! What's going on — an order, billing, a login, or a return?",
          "Hi again! Tell me what you need and I'll take it from there."
        ]
      }
    },
    "verify": {
      "id": "verify",
      "label": "Verify identity",
      "agentSay": [
        "Absolutely — I can help you with that. Would it be okay if I asked you some questions to pull up and secure your account?",
        "What is your name, and if you don't have an account I can help you set one up. You can also use demo account 1001, 2044, or 3300."
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "provide_account",
          "examples": [
            "my account is 1001",
            "account 2044",
            "3300",
            "it's 1001",
            "use 2044"
          ]
        },
        {
          "intent": "provide_name",
          "examples": [
            "my name is Maya Chen",
            "I'm Chris Patel",
            "this is Jordan",
            "call me Sam"
          ]
        },
        {
          "intent": "no_account",
          "examples": [
            "I don't have an account",
            "no account yet",
            "I'm a new customer",
            "can you set one up",
            "create an account for me"
          ]
        },
        {
          "intent": "verify_identity",
          "examples": [
            "last four 1001",
            "yes I'm the account holder",
            "sure go ahead"
          ]
        },
        {
          "intent": "escalate",
          "examples": [
            "supervisor please",
            "get me a manager",
            "transfer me to someone else",
            "escalate this"
          ]
        },
        {
          "intent": "request_callback",
          "examples": [
            "callback please",
            "call me later"
          ]
        }
      ],
      "requireSlots": [
        "accountId"
      ],
      "toolsAllowed": [
        "lookupAccount",
        "createCustomer"
      ],
      "transitions": [
        {
          "on": "escalate",
          "to": "escalate_handoff",
          "whenSlotsFilled": [
            "accountId"
          ]
        },
        {
          "on": "request_callback",
          "to": "callback_close",
          "whenSlotsFilled": [
            "accountId"
          ]
        },
        {
          "on": "provide_account",
          "to": "retention",
          "whenSlotsFilled": [
            "cancelRequest"
          ]
        },
        {
          "on": "provide_account",
          "to": "address_update",
          "whenSlotsFilled": [
            "addressChange"
          ]
        },
        {
          "on": "verify_identity",
          "to": "retention",
          "whenSlotsFilled": [
            "cancelRequest"
          ]
        },
        {
          "on": "verify_identity",
          "to": "address_update",
          "whenSlotsFilled": [
            "addressChange"
          ]
        },
        {
          "on": "slots_filled",
          "to": "retention",
          "whenSlotsFilled": [
            "cancelRequest"
          ]
        },
        {
          "on": "slots_filled",
          "to": "address_update",
          "whenSlotsFilled": [
            "addressChange"
          ]
        },
        {
          "on": "provide_account",
          "to": "diagnose",
          "whenSlotsFilled": [
            "accountId"
          ]
        },
        {
          "on": "provide_name",
          "to": "diagnose",
          "whenSlotsFilled": [
            "accountId"
          ]
        },
        {
          "on": "verify_identity",
          "to": "diagnose",
          "whenSlotsFilled": [
            "accountId"
          ]
        },
        {
          "on": "no_account",
          "to": "verify"
        },
        {
          "on": "slots_filled",
          "to": "diagnose",
          "whenSlotsFilled": [
            "accountId"
          ]
        }
      ],
      "agentSayVariants": {
        "knownName": [
          "Thanks, {{customerName}}. Do you have an account number handy? If not, I can set one up for you right now."
        ],
        "accountNotFound": [
          "I couldn't find an account with that number. Could you double-check it? If you're new, just tell me your name and I'll set one up — demo accounts 1001, 2044, and 3300 also work."
        ],
        "reprompt": [
          "Could you share your name or your account number? If you don't have an account, I can set one up — demo accounts 1001, 2044, and 3300 also work."
        ],
        "accountCreated": [
          "You're all set, {{customerName}} — I've created account {{accountId}} for you. What can I help you with today?"
        ],
        "accountReady": [
          "Thanks, {{customerName}} — I've pulled up account {{accountId}}. What can I help you with today?"
        ],
        "needsName": [
          "No problem — I can set up a new account for you. What name should I put on it?"
        ],
        "settingUp": [
          "Thanks, {{customerName}}. I'll set up a new account for you now — what can I help you with today?"
        ]
      },
      "holdForSlots": [
        "reason"
      ]
    },
    "diagnose": {
      "id": "diagnose",
      "label": "Diagnose",
      "agentSay": [
        "Thanks — account {{accountId}} is on file. Tell me a little more about what happened so I can pull the right procedure."
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "describe_issue",
          "examples": [
            "it still won't ship",
            "charged twice",
            "can't reset password",
            "cracked on arrival",
            "tracking hasn't moved",
            "wrong color"
          ]
        },
        {
          "intent": "ask_policy",
          "examples": [
            "what does the policy say",
            "am I eligible",
            "is this under warranty"
          ]
        },
        {
          "intent": "escalate",
          "examples": [
            "I want a supervisor",
            "transfer me",
            "this is ridiculous get me a manager"
          ]
        },
        {
          "intent": "cancel_service",
          "examples": [
            "I want to cancel",
            "cancel my subscription",
            "close my account"
          ]
        },
        {
          "intent": "update_address",
          "examples": [
            "change my address",
            "I moved",
            "update my shipping address"
          ]
        },
        {
          "intent": "request_callback",
          "examples": [
            "callback please",
            "call me later"
          ]
        }
      ],
      "rag": {
        "queryHint": "customer service returns shipping warranty billing login escalation",
        "required": false,
        "topicFirst": true
      },
      "transitions": [
        {
          "on": "cancel_service",
          "to": "retention"
        },
        {
          "on": "update_address",
          "to": "address_update"
        },
        {
          "on": "*",
          "to": "retention",
          "whenSlotsFilled": [
            "cancelRequest"
          ]
        },
        {
          "on": "*",
          "to": "address_update",
          "whenSlotsFilled": [
            "addressChange"
          ]
        },
        {
          "on": "ask_policy",
          "to": "policy"
        },
        {
          "on": "describe_issue",
          "to": "policy"
        },
        {
          "on": "escalate",
          "to": "escalate_handoff"
        },
        {
          "on": "request_callback",
          "to": "callback_close"
        },
        {
          "on": "*",
          "to": "policy"
        }
      ],
      "agentSayVariants": {
        "knownReason": [
          "Thanks — account {{accountId}} is all set. About the {{reason}}: what's happened so far, so I can pull the right procedure?"
        ]
      },
      "agentSayWhen": [
        {
          "slot": "repeatCaller",
          "lines": [
            "I'm sorry you've had to call back about this — let's get it sorted this time. Account {{accountId}} is on file. Tell me where things stand, and I'll make sure it's documented so you don't have to repeat yourself."
          ]
        }
      ]
    },
    "policy": {
      "id": "policy",
      "label": "Policy lookup",
      "agentSay": [
        "I'm checking our support procedures now. I'll share what applies in plain language, then we can resolve it, open a case, or escalate if you prefer."
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "describe_issue",
          "examples": [
            "it's been 14 days and no package",
            "I still haven't received it",
            "tracking hasn't moved",
            "I want a refund",
            "send a replacement",
            "charged twice on my card"
          ]
        },
        {
          "intent": "resolve",
          "examples": [
            "that answers it",
            "thanks that works",
            "we're good",
            "that helps",
            "no that's all",
            "that's all",
            "nothing else",
            "bye",
            "I'm good"
          ]
        },
        {
          "intent": "escalate",
          "examples": [
            "still not happy",
            "supervisor please",
            "I want a manager"
          ]
        },
        {
          "intent": "create_ticket",
          "examples": [
            "open a ticket",
            "create a case",
            "please document this"
          ]
        },
        {
          "intent": "request_callback",
          "examples": [
            "call me back",
            "callback tomorrow",
            "can someone call me afternoon"
          ]
        }
      ],
      "rag": {
        "queryHint": "refund return exchange warranty shipping delay lost package login billing duplicate charge escalation privacy",
        "required": true,
        "topicFirst": true
      },
      "toolsAllowed": [
        "createCase",
        "scheduleCallback",
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "describe_issue",
          "to": "policy"
        },
        {
          "on": "resolve",
          "to": "resolve_close"
        },
        {
          "on": "create_ticket",
          "to": "resolve_close"
        },
        {
          "on": "escalate",
          "to": "escalate_handoff"
        },
        {
          "on": "request_callback",
          "to": "callback_close"
        }
      ],
      "exits": [
        {
          "type": "resolve",
          "label": "Resolved with policy citation"
        },
        {
          "type": "escalate",
          "label": "Escalated to human queue"
        },
        {
          "type": "callback",
          "label": "Callback scheduled"
        }
      ],
      "agentSayVariants": {
        "reprompt": [
          "Here's what our procedure says for that."
        ]
      }
    },
    "resolve_close": {
      "id": "resolve_close",
      "label": "Resolve",
      "agentSay": [
        "I'm glad we could sort this. I've logged the disposition on account {{accountId}}. Is there anything else I can help with before we wrap up?"
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "resolve",
          "examples": [
            "no that's all",
            "thanks bye"
          ]
        },
        {
          "intent": "describe_issue",
          "examples": [
            "one more thing"
          ]
        }
      ],
      "toolsAllowed": [
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "resolve",
          "to": "exit:resolve"
        },
        {
          "on": "*",
          "to": "exit:resolve"
        }
      ],
      "exits": [
        {
          "type": "resolve",
          "label": "Call resolved"
        }
      ]
    },
    "escalate_handoff": {
      "id": "escalate_handoff",
      "label": "Escalate",
      "agentSay": [
        "I understand — I’m opening a case with a clear summary so you don’t have to repeat yourself, and moving this to the escalation queue. A specialist will pick it up from there, and the case keeps everything we covered."
      ],
      "allowParaphrase": false,
      "listenFor": [
        {
          "intent": "affirm",
          "examples": [
            "ok",
            "please do"
          ]
        }
      ],
      "toolsAllowed": [
        "createCase",
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "*",
          "to": "exit:escalate"
        }
      ],
      "exits": [
        {
          "type": "escalate",
          "label": "Escalated to human queue"
        }
      ]
    },
    "callback_close": {
      "id": "callback_close",
      "label": "Schedule callback",
      "agentSay": [
        "Absolutely — I'll schedule a callback on this account and attach notes so we pick up where we left off. Would morning, afternoon, or tomorrow work better?"
      ],
      "agentSayVariants": {
        "scheduled": [
          "You’re all set — callback {{callbackId}} is booked for {{callbackWindow}}, and I’ve attached notes so we pick up right where we left off."
        ]
      },
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "request_callback",
          "examples": [
            "afternoon",
            "tomorrow morning",
            "call me tonight"
          ]
        }
      ],
      "toolsAllowed": [
        "scheduleCallback",
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "*",
          "to": "exit:callback"
        }
      ],
      "exits": [
        {
          "type": "callback",
          "label": "Callback scheduled"
        }
      ]
    },
    "retention": {
      "id": "retention",
      "label": "Cancellation / retention",
      "agentSay": [
        "I'm sorry to hear you're thinking about cancelling. Before I note anything, may I ask what's driving it? If it's cost or a specific problem, there may be an option that fixes it — and if you'd still like to cancel, that's completely your call."
      ],
      "allowParaphrase": true,
      "askOnStay": true,
      "listenFor": [
        {
          "intent": "confirm_cancel",
          "examples": [
            "just cancel it",
            "I still want to cancel",
            "yes cancel",
            "please cancel",
            "no just cancel"
          ]
        },
        {
          "intent": "describe_issue",
          "examples": [
            "it's too expensive",
            "the app keeps crashing",
            "I'm not using it",
            "shipping is always late"
          ]
        },
        {
          "intent": "accept_save",
          "examples": [
            "what are my options",
            "tell me more",
            "ok I'll hear it",
            "maybe I'll stay"
          ]
        },
        {
          "intent": "escalate",
          "examples": [
            "I want a supervisor",
            "get me a manager"
          ]
        }
      ],
      "toolsAllowed": [
        "logDisposition",
        "createCase"
      ],
      "rag": {
        "queryHint": "cancellation retention save options",
        "required": true
      },
      "transitions": [
        {
          "on": "confirm_cancel",
          "to": "exit:resolve:cancel"
        },
        {
          "on": "describe_issue",
          "to": "policy"
        },
        {
          "on": "accept_save",
          "to": "policy"
        },
        {
          "on": "escalate",
          "to": "escalate_handoff"
        }
      ],
      "exits": [
        {
          "type": "resolve",
          "key": "cancel",
          "label": "Cancellation request logged",
          "disposition": "cancel_requested",
          "say": [
            "Understood — I've logged your cancellation request on account {{accountId}}. I'm sorry to see you go, and thank you for being a customer."
          ]
        }
      ]
    },
    "address_update": {
      "id": "address_update",
      "label": "Address change",
      "agentSay": [
        "Happy to update that. What's the new street address and postal code? For this demo, the address itself isn't stored."
      ],
      "allowParaphrase": true,
      "askOnStay": true,
      "requireSlots": [
        "newAddress"
      ],
      "listenFor": [
        {
          "intent": "provide_address",
          "examples": [
            "123 Main Street",
            "my new address is",
            "it's 45 King Street West"
          ]
        },
        {
          "intent": "escalate",
          "examples": [
            "supervisor please"
          ]
        }
      ],
      "toolsAllowed": [
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "slots_filled",
          "to": "exit:resolve:address"
        },
        {
          "on": "escalate",
          "to": "escalate_handoff"
        }
      ],
      "exits": [
        {
          "type": "resolve",
          "key": "address",
          "label": "Address change request logged",
          "disposition": "address_change",
          "say": [
            "Thanks — I've noted the address change request on account {{accountId}}. Thanks for calling, and take care."
          ]
        }
      ]
    }
  }
}
