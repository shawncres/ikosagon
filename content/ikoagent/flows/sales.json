{
  "id": "sales",
  "title": "Sales",
  "vertical": "sales",
  "description": "Greet → discover → match offer (RAG) → objections / competitor / trial → close or callback. Ethical sales corpus.",
  "start": "greet",
  "ragCorpus": "sales",
  "tools": [
    "lookupAccount",
    "scheduleCallback",
    "logDisposition",
    "createCase"
  ],
  "nodes": {
    "greet": {
      "id": "greet",
      "label": "Greet",
      "agentSay": [
        "Hello there — thanks for hopping on this IkoAgent sales demo with Ikosagon. How can I help you today? What are you hoping to solve?"
      ],
      "allowParaphrase": true,
      "askOnStay": true,
      "listenFor": [
        {
          "intent": "discover_need",
          "examples": [
            "need better support",
            "want analytics",
            "looking for a cheaper plan",
            "need phone support",
            "we need SSO",
            "growing team",
            "security review"
          ]
        },
        {
          "intent": "ask_offer",
          "examples": [
            "what do you offer",
            "show me plans",
            "pricing please",
            "compare basic and pro"
          ]
        }
      ],
      "requireSlots": [
        "need"
      ],
      "transitions": [
        {
          "on": "discover_need",
          "to": "discover"
        },
        {
          "on": "ask_offer",
          "to": "discover"
        },
        {
          "on": "slots_filled",
          "to": "discover",
          "whenSlotsFilled": [
            "need"
          ]
        }
      ],
      "agentSayVariants": {
        "reprompt": [
          "Happy to help — you don't need an account to talk plans with us. What are you hoping to solve: a plan for your team, an upgrade, or a trial?"
        ]
      }
    },
    "discover": {
      "id": "discover",
      "label": "Discover needs",
      "agentSay": [
        "Absolutely — I can help you with {{need}}. Is this for a small team, or are you thinking enterprise scale? Any must-haves like phone support, SSO, or a security review?"
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "discover_need",
          "examples": [
            "small team",
            "enterprise",
            "need phone support",
            "need SSO",
            "about ten seats",
            "just email support is fine",
            "compliance questionnaire"
          ]
        },
        {
          "intent": "ask_offer",
          "examples": [
            "what's the pro plan",
            "compare plans",
            "tell me about enterprise"
          ]
        },
        {
          "intent": "book_demo",
          "examples": [
            "book a demo",
            "schedule a demo",
            "can I see a walkthrough",
            "set up a demo",
            "show me a demo"
          ]
        },
        {
          "intent": "objection_price",
          "examples": [
            "too expensive",
            "out of budget"
          ]
        }
      ],
      "transitions": [
        {
          "on": "book_demo",
          "to": "demo_book"
        },
        {
          "on": "objection_price",
          "to": "objection"
        },
        {
          "on": "ask_offer",
          "to": "match_offer"
        },
        {
          "on": "discover_need",
          "to": "match_offer"
        },
        {
          "on": "*",
          "to": "match_offer"
        }
      ],
      "agentSayWhen": [
        {
          "slot": "need",
          "missing": true,
          "lines": [
            "Happy to help. Is this for a small team, or are you thinking enterprise scale? Any must-haves like phone support, SSO, or a security review?"
          ]
        }
      ]
    },
    "match_offer": {
      "id": "match_offer",
      "label": "Match offer",
      "agentSay": [
        "Based on that, I’ll pull a matching offer from our sales procedures and summarize fit in plain language — you can choose Basic, Pro, a trial, or a callback. No pressure."
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "ask_offer",
          "examples": [
            "tell me more",
            "pricing",
            "what's included",
            "compare basic and pro"
          ]
        },
        {
          "intent": "objection_price",
          "examples": [
            "too expensive",
            "out of budget",
            "cheaper option",
            "need a discount"
          ]
        },
        {
          "intent": "objection_timing",
          "examples": [
            "not now",
            "maybe next quarter",
            "call me later",
            "busy this month"
          ]
        },
        {
          "intent": "close_won",
          "examples": [
            "I'll take it",
            "let's sign up",
            "buy pro",
            "start the trial"
          ]
        },
        {
          "intent": "request_callback",
          "examples": [
            "email me",
            "call me later",
            "schedule a follow-up",
            "call me back"
          ]
        },
        {
          "intent": "objection_competitor",
          "examples": [
            "competitor is cheaper",
            "we use another tool",
            "how do you compare to others",
            "we already have a vendor",
            "another company quoted less"
          ]
        },
        {
          "intent": "objection_authority",
          "examples": [
            "I need to ask my boss",
            "I need approval",
            "let me check with my manager",
            "I have to run it by my team",
            "my director decides"
          ]
        },
        {
          "intent": "book_demo",
          "examples": [
            "book a demo",
            "schedule a demo",
            "can I see a walkthrough",
            "set up a demo",
            "show me a demo"
          ]
        }
      ],
      "rag": {
        "queryHint": "plan comparison Basic Pro Enterprise trial pricing features SSO",
        "required": false
      },
      "transitions": [
        {
          "on": "objection_competitor",
          "to": "objection"
        },
        {
          "on": "objection_authority",
          "to": "objection"
        },
        {
          "on": "book_demo",
          "to": "demo_book"
        },
        {
          "on": "objection_price",
          "to": "objection"
        },
        {
          "on": "objection_timing",
          "to": "objection"
        },
        {
          "on": "close_won",
          "to": "close"
        },
        {
          "on": "request_callback",
          "to": "callback"
        },
        {
          "on": "ask_offer",
          "to": "objection"
        },
        {
          "on": "*",
          "to": "objection"
        }
      ],
      "agentSayWhen": [
        {
          "slot": "recommendedPlan",
          "lines": [
            "Based on what you've told me, {{recommendedPlan}} looks like the best fit. {{planWhy}} You can start a fourteen-day trial, book a demo walkthrough, or take a callback — no pressure."
          ]
        }
      ]
    },
    "objection": {
      "id": "objection",
      "label": "Handle objection",
      "agentSay": [
        "That’s a fair concern. We can look at Basic versus Pro, offer a fourteen-day Pro trial, or schedule a deeper walkthrough. What would make this a yes for you — price, timing, or features?"
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "objection_price",
          "examples": [
            "still too pricey",
            "need a discount",
            "can you do better on price"
          ]
        },
        {
          "intent": "objection_timing",
          "examples": [
            "later",
            "next month",
            "after budget cycle"
          ]
        },
        {
          "intent": "close_won",
          "examples": [
            "ok let's do pro",
            "sign me up",
            "I'll try the trial"
          ]
        },
        {
          "intent": "request_callback",
          "examples": [
            "callback please",
            "call tomorrow",
            "send info later"
          ]
        },
        {
          "intent": "ask_offer",
          "examples": [
            "compare basic and pro",
            "what about enterprise",
            "tell me more"
          ]
        },
        {
          "intent": "objection_competitor",
          "examples": [
            "competitor is cheaper",
            "we use another tool",
            "how do you compare to others",
            "we already have a vendor",
            "another company quoted less"
          ]
        },
        {
          "intent": "objection_authority",
          "examples": [
            "I need to ask my boss",
            "I need approval",
            "let me check with my manager",
            "I have to run it by my team",
            "my director decides"
          ]
        },
        {
          "intent": "book_demo",
          "examples": [
            "book a demo",
            "schedule a demo",
            "can I see a walkthrough",
            "set up a demo",
            "show me a demo"
          ]
        }
      ],
      "rag": {
        "queryHint": "objection handling price timing trial competitor upsell without pressure",
        "required": false
      },
      "transitions": [
        {
          "on": "book_demo",
          "to": "demo_book"
        },
        {
          "on": "objection_competitor",
          "to": "objection"
        },
        {
          "on": "objection_authority",
          "to": "objection"
        },
        {
          "on": "close_won",
          "to": "close"
        },
        {
          "on": "request_callback",
          "to": "callback"
        },
        {
          "on": "objection_timing",
          "to": "callback"
        },
        {
          "on": "objection_price",
          "to": "close"
        },
        {
          "on": "*",
          "to": "close"
        }
      ],
      "agentSayWhen": [
        {
          "slot": "objectionType",
          "equals": "competitor",
          "lines": [
            "Fair question — I won't knock anyone else. The honest comparison is fit for your team. A fourteen-day trial is the easiest way to compare side by side. Want to start one, or book a demo walkthrough?"
          ]
        },
        {
          "slot": "objectionType",
          "equals": "timing",
          "lines": [
            "No rush at all. I can schedule a callback for when the timing is better, or you can start a fourteen-day trial whenever you're ready. Which would you prefer?"
          ]
        },
        {
          "slot": "objectionType",
          "equals": "authority",
          "lines": [
            "That makes sense — who else should weigh in? I can book a demo walkthrough for you and your manager, or schedule a callback once you've talked it over."
          ]
        },
        {
          "slot": "objectionType",
          "equals": "price",
          "lines": [
            "Budget matters. Before we talk price, would a fourteen-day Pro trial help you prove the value? If not, Basic keeps costs lower and you can move up later. What would make this a yes for you?"
          ]
        }
      ]
    },
    "close": {
      "id": "close",
      "label": "Close",
      "agentSay": [
        "Wonderful — I’m marking this demo as a close path. In production this would hand off to checkout or a human AE. Thanks for walking the flow with me."
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "close_won",
          "examples": [
            "confirm",
            "yes"
          ]
        },
        {
          "intent": "resolve",
          "examples": [
            "thanks",
            "done"
          ]
        }
      ],
      "toolsAllowed": [
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "*",
          "to": "exit:resolve"
        }
      ],
      "exits": [
        {
          "type": "resolve",
          "label": "Closed — demo win path"
        }
      ],
      "agentSayWhen": [
        {
          "slot": "upsellNote",
          "lines": [
            "Wonderful — I'm marking this demo as a close path. One honest note, no pressure: {{upsellNote}} In production this would hand off to checkout or a human AE. Thanks for walking the flow with me."
          ]
        }
      ]
    },
    "callback": {
      "id": "callback",
      "label": "Callback",
      "agentSay": [
        "Of course — I’ll schedule a callback so you can decide on your timeline. Would morning or afternoon work better?"
      ],
      "agentSayVariants": {
        "scheduled": [
          "You’re all set — callback {{callbackId}} is booked for {{callbackWindow}}, so you can decide on your own timeline."
        ]
      },
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "request_callback",
          "examples": [
            "afternoon",
            "tomorrow morning"
          ]
        }
      ],
      "toolsAllowed": [
        "scheduleCallback",
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "*",
          "to": "exit:callback"
        }
      ],
      "exits": [
        {
          "type": "callback",
          "label": "Sales callback scheduled"
        }
      ]
    },
    "demo_book": {
      "id": "demo_book",
      "label": "Book demo",
      "agentSay": [
        "Happy to set up a demo walkthrough. Would morning or afternoon work better?"
      ],
      "agentSayWhen": [
        {
          "slot": "callbackWindow",
          "lines": [
            "I can book that walkthrough for {{callbackWindow}} — shall I lock it in?"
          ]
        }
      ],
      "agentSayVariants": {
        "scheduled": [
          "You're booked — demo walkthrough {{callbackId}} is set for {{callbackWindow}}. Thanks for your time today."
        ]
      },
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "request_callback",
          "examples": [
            "morning",
            "afternoon",
            "tomorrow morning",
            "yes lock it in",
            "sounds good"
          ]
        }
      ],
      "toolsAllowed": [
        "scheduleCallback",
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "*",
          "to": "exit:callback"
        }
      ],
      "exits": [
        {
          "type": "callback",
          "label": "Demo walkthrough booked"
        }
      ]
    }
  }
}
