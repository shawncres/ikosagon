{
  "id": "sales",
  "title": "Sales",
  "vertical": "sales",
  "description": "Greet → discover → match offer (RAG) → objections / competitor / trial → close or callback. Ethical sales corpus.",
  "start": "greet",
  "ragCorpus": "sales",
  "tools": [
    "lookupAccount",
    "scheduleCallback",
    "logDisposition",
    "createCase"
  ],
  "nodes": {
    "greet": {
      "id": "greet",
      "label": "Greet",
      "agentSay": [
        "Hello there — thanks for hopping on this IkoAgent sales demo with Ikosagon. How can I help you today? What are you hoping to solve?"
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "discover_need",
          "examples": [
            "need better support",
            "want analytics",
            "looking for a cheaper plan",
            "need phone support",
            "we need SSO",
            "growing team",
            "security review"
          ]
        },
        {
          "intent": "ask_offer",
          "examples": [
            "what do you offer",
            "show me plans",
            "pricing please",
            "compare basic and pro"
          ]
        }
      ],
      "requireSlots": [
        "need"
      ],
      "transitions": [
        {
          "on": "discover_need",
          "to": "discover"
        },
        {
          "on": "ask_offer",
          "to": "discover"
        },
        {
          "on": "slots_filled",
          "to": "discover",
          "whenSlotsFilled": [
            "need"
          ]
        }
      ]
    },
    "discover": {
      "id": "discover",
      "label": "Discover needs",
      "agentSay": [
        "Absolutely — I can help you with {{need}}. Is this for a small team, or are you thinking enterprise scale? Any must-haves like phone support, SSO, or deeper analytics?"
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "discover_need",
          "examples": [
            "small team",
            "enterprise",
            "need phone support",
            "need SSO",
            "about ten seats",
            "just email support is fine",
            "compliance questionnaire"
          ]
        },
        {
          "intent": "ask_offer",
          "examples": [
            "what's the pro plan",
            "compare plans",
            "tell me about enterprise"
          ]
        }
      ],
      "transitions": [
        {
          "on": "ask_offer",
          "to": "match_offer"
        },
        {
          "on": "discover_need",
          "to": "match_offer"
        },
        {
          "on": "*",
          "to": "match_offer"
        }
      ]
    },
    "match_offer": {
      "id": "match_offer",
      "label": "Match offer",
      "agentSay": [
        "Based on that, I’ll pull a matching offer from our sales procedures and summarize fit in plain language — you can choose Basic, Pro, a trial, or a callback. No pressure."
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "ask_offer",
          "examples": [
            "tell me more",
            "pricing",
            "what's included",
            "compare basic and pro"
          ]
        },
        {
          "intent": "objection_price",
          "examples": [
            "too expensive",
            "out of budget",
            "cheaper option",
            "need a discount"
          ]
        },
        {
          "intent": "objection_timing",
          "examples": [
            "not now",
            "maybe next quarter",
            "call me later",
            "busy this month"
          ]
        },
        {
          "intent": "close_won",
          "examples": [
            "I'll take it",
            "let's sign up",
            "buy pro",
            "start the trial"
          ]
        },
        {
          "intent": "request_callback",
          "examples": [
            "email me",
            "call me later",
            "schedule a follow-up"
          ]
        }
      ],
      "rag": {
        "queryHint": "plan comparison Basic Pro Enterprise trial pricing features SSO",
        "required": true
      },
      "transitions": [
        {
          "on": "objection_price",
          "to": "objection"
        },
        {
          "on": "objection_timing",
          "to": "objection"
        },
        {
          "on": "close_won",
          "to": "close"
        },
        {
          "on": "request_callback",
          "to": "callback"
        },
        {
          "on": "ask_offer",
          "to": "objection"
        },
        {
          "on": "*",
          "to": "objection"
        }
      ]
    },
    "objection": {
      "id": "objection",
      "label": "Handle objection",
      "agentSay": [
        "That’s a fair concern. We can look at Basic versus Pro, offer a fourteen-day Pro trial, or schedule a deeper walkthrough. What would make this a yes for you — price, timing, or features?"
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "objection_price",
          "examples": [
            "still too pricey",
            "need a discount",
            "competitor is cheaper"
          ]
        },
        {
          "intent": "objection_timing",
          "examples": [
            "later",
            "next month",
            "after budget cycle"
          ]
        },
        {
          "intent": "close_won",
          "examples": [
            "ok let's do pro",
            "sign me up",
            "I'll try the trial"
          ]
        },
        {
          "intent": "request_callback",
          "examples": [
            "callback please",
            "call tomorrow",
            "send info later"
          ]
        },
        {
          "intent": "ask_offer",
          "examples": [
            "compare basic and pro",
            "what about enterprise",
            "how do you compare to others"
          ]
        }
      ],
      "rag": {
        "queryHint": "objection handling price timing trial competitor upsell without pressure",
        "required": false
      },
      "transitions": [
        {
          "on": "close_won",
          "to": "close"
        },
        {
          "on": "request_callback",
          "to": "callback"
        },
        {
          "on": "objection_timing",
          "to": "callback"
        },
        {
          "on": "objection_price",
          "to": "close"
        },
        {
          "on": "*",
          "to": "close"
        }
      ]
    },
    "close": {
      "id": "close",
      "label": "Close",
      "agentSay": [
        "Wonderful — I’m marking this demo as a close path. In production this would hand off to checkout or a human AE. Thanks for walking the flow with me."
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "close_won",
          "examples": [
            "confirm",
            "yes"
          ]
        },
        {
          "intent": "resolve",
          "examples": [
            "thanks",
            "done"
          ]
        }
      ],
      "toolsAllowed": [
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "*",
          "to": "exit:resolve"
        }
      ],
      "exits": [
        {
          "type": "resolve",
          "label": "Closed — demo win path"
        }
      ]
    },
    "callback": {
      "id": "callback",
      "label": "Callback",
      "agentSay": [
        "Of course — I’ll schedule a callback so you can decide on your timeline. Would morning or afternoon work better?"
      ],
      "allowParaphrase": true,
      "listenFor": [
        {
          "intent": "request_callback",
          "examples": [
            "afternoon",
            "tomorrow morning"
          ]
        }
      ],
      "toolsAllowed": [
        "scheduleCallback",
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "*",
          "to": "exit:callback"
        }
      ],
      "exits": [
        {
          "type": "callback",
          "label": "Sales callback scheduled"
        }
      ]
    }
  }
}
