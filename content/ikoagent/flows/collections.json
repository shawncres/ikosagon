    "identity": {
      "id": "identity",
      "label": "Identity",
      "agentSay": [
        "Hello there — this is the IkoAgent collections demonstration line with Ikosagon. May I confirm I'm speaking with the account holder? Please share demo account 1001, 2044, or 3300."
      ],
      "allowParaphrase": true,
      "askOnStay": true,
      "listenFor": [
        {
          "intent": "provide_account",
          "examples": [
            "account 2044",
            "this is 1001",
            "3300",
            "my number is 2044"
          ]
        },
        {
          "intent": "verify_identity",
          "examples": [
            "yes it's me",
            "I am the account holder",
            "speaking"
          ]
        },
        {
          "intent": "deny",
          "examples": [
            "wrong number",
            "not me",
            "you have the wrong person",
            "never heard of this",
            "that's not me",
            "nobody by that name"
          ]
        },
        {
          "intent": "no_account",
          "examples": [
            "I don't have an account",
            "I don't have one",
            "I never had an account",
            "no account"
          ]
        },
        {
          "intent": "unsure",
          "examples": [
            "I'm not sure",
            "maybe",
            "I don't know",
            "not sure if that's me"
          ]
        },
        {
          "intent": "ask_purpose",
          "examples": [
            "what is this about",
            "what's this regarding",
            "who is this",
            "why are you calling",
            "what is this call about"
          ]
        },
        {
          "intent": "third_party",
          "examples": [
            "he's not here",
            "she's not home",
            "this is his wife",
            "I'm calling for my mother",
            "can I take a message",
            "he's at work",
            "I'm her husband"
          ]
        },
        {
          "intent": "cease_contact",
          "examples": [
            "stop calling me",
            "do not call me again",
            "cease and desist",
            "take me off your list",
            "don't contact me anymore"
          ]
        }
      ],
      "requireSlots": [
        "accountId"
      ],
      "toolsAllowed": [
        "lookupAccount",
        "logDisposition"
      ],
      "transitions": [
        {
          "on": "third_party",
          "to": "exit:refuse:third_party"
        },
        {
          "on": "cease_contact",
          "to": "exit:refuse:cease"
        },
        {
          "on": "deny",
          "to": "exit:refuse",
          "whenSlotsFilled": [
            "clarified"
          ]
        },
        {
          "on": "no_account",
          "to": "exit:refuse",
          "whenSlotsFilled": [
            "clarified"
          ]
        },
        {
          "on": "provide_account",
          "to": "disclosure",
          "whenSlotsFilled": [
            "accountId"
          ]
        },
        {
          "on": "verify_identity",
          "to": "disclosure",
          "whenSlotsFilled": [
            "accountId"
          ]
        },
        {
          "on": "slots_filled",
          "to": "disclosure",
          "whenSlotsFilled": [
            "accountId"
          ]
        }
      ],
      "exits": [
        {
          "type": "refuse",
          "label": "Wrong party — number marked, call ended",
          "disposition": "wrong_party",
          "say": [
            "I'm sorry for the inconvenience. I've noted that we reached the wrong person, and this number is marked on our side. Thank you for your time — goodbye."
          ]
        },
        {
          "type": "refuse",
          "key": "third_party",
          "label": "Third party — no details shared",
          "disposition": "third_party_no_disclosure",
          "say": [
            "Thank you. I can only discuss this with the account holder, so I won't share any details. Please ask them to call the IkoAgent demo line back. Goodbye."
          ]
        },
        {
          "type": "refuse",
          "key": "cease",
          "label": "Stop request — contact stopped",
          "disposition": "STOP",
          "say": [
            "Understood — I've noted your request to stop these calls. Thank you, and goodbye."
          ]
        }
      ],
      "noDisclosure": true,
      "clarify": {
        "intents": [
          "deny",
          "no_account",
          "unsure",
          "ask_purpose"
        ],
        "slot": "clarified"
      },
      "agentSayVariants": {
        "clarify": [
          "No problem — let me explain. This line is for existing demo accounts, so I need to make sure I'm speaking with the account holder before I can share anything. Are you the account holder? If so, please share the account number or the name on the account — for this demo you can use account 1001, 2044, or 3300. If you think we've reached you in error, just tell me and I'll note it."
        ],
        "clarifyAgain": [
          "Understood. If you're the account holder, the account number is all I need — for this demo, 1001, 2044, or 3300 works. If this isn't you, just say so and I'll note that we reached the wrong person."
        ],
        "reprompt": [
          "Thanks. To pull up the account, please share the account number — for this demo, 1001, 2044, or 3300."
        ],
        "accountNotFound": [
          "I couldn't find that account number. Could you double-check it? For this demo, try 1001, 2044, or 3300 — or tell me if you think we've reached the wrong person."
        ]
      }
    },
