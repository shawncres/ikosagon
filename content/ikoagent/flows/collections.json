          "intent": "already_paid",
          "examples": [
            "I already paid this",
            "I paid it off",
            "this was paid last month",
            "I sent the payment already",
            "it's been paid"
          ]
        },
        {
          "intent": "cease_contact",
          "examples": [
            "stop calling me",
            "do not call me again",
            "cease and desist",
            "take me off your list",
            "don't contact me anymore"
