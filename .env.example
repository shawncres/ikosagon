# Resend (https://resend.com) — required for the contact form to send email
RESEND_API_KEY=re_xxxxxxxx

# Verified sender domain in Resend (e.g. onboarding@resend.dev or mail@ikosagon.com)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Optional — defaults to shawn@ikosagon.com if unset
CONTACT_TO_EMAIL=shawn@ikosagon.com
