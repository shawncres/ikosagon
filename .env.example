# Resend (https://resend.com) — required for the contact form to send email
RESEND_API_KEY=re_xxxxxxxx

# Verified sender in Resend (production pattern: hello@send.ikosagon.com;
# local/dev may use onboarding@resend.dev until the send domain is verified)
CONTACT_FROM_EMAIL=hello@send.ikosagon.com

# Optional — defaults to shawn@ikosagon.com if unset (used by /api/contact and /api/talent-intake)
CONTACT_TO_EMAIL=shawn@ikosagon.com

# Grounded site chat — set ONE provider key. Retrieval still works with none.
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Optional model override (defaults: llama-3.1-8b-instant / grok-3-mini / gpt-4o-mini)
CHAT_MODEL=

# Optional — IkoAgent demo transcript dump API (/api/ikoagent/log). Free: structured
# Vercel runtime logs only. Leave unset to rely on demo UI Copy/Download + localStorage.
# Never expose this value to the browser. IKOLINE_LOG_SECRET is still accepted as a legacy alias.
IKOAGENT_LOG_SECRET=
# IKOLINE_LOG_SECRET=

# Optional — IkoArtist track data from Last.fm (free API key, NON-COMMERCIAL terms; see README "IkoArtist data").
# Server-side only: never prefix with NEXT_PUBLIC_. Leave unset and IkoArtist uses its editorial seed picks
# (nothing breaks, no Last.fm credit is shown). Register at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional - IkoReadTube summaries (/ikoreadtube/ -> /api/ikoreadtube/summarize) reuse GROQ_API_KEY above
# (free key from https://console.groq.com/keys). Without it the page shows its hardcoded preset summaries.
# GROQ_MODEL=openai/gpt-oss-20b
# IKOREADTUBE_ALLOWED_ORIGINS=https://example.com   # extra CORS origins (ikosagon.com and www are built in)
